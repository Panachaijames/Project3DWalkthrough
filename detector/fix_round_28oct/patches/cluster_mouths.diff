+                        #    corridor crossings through (L30-026)
+WALL_RUN = 0.45         # m: a face that runs on this far is a wall carrying on, not the end face of a corner or of a cross
+                        #    wall (as long as the wall is thick). Range 0.25-0.9: the corner of the false Sukhumvit
+                        #    upper-039 runs 0.25 m; GW-10 carries on 0.90 m (O3 0.68, AUD-01 0.88)
+DOORWAY = 1.4           # m: a gap between two flush corners is a doorway only this wide at most (a pair of leaves).
+                        #    Range 1.32-1.55: UW-06 is 1.30 m wide, the false L29-029 and upper-039 are 1.59 and 1.55 m
+FACE_TOL = 0.03         # m: two faces are in line within this (the tolerance that closes cracks, rule 1). The keys do not
+                        #    mind (0.005-0.1); false detections come in above 0.04 (one more per 0.01)
+FACE_REACH = 0.10       # m: the centre line meets the far wall within this of the gap's end, else the end is no face. Range
+                        #    0.02-0.33: a face 1.6 cm off (presidential suite-024) is one. From 0.35 m the ragged end of the
+                        #    false suite-021 (0.34 m off) would count as a face too, and O1's (1.0 m off) is lost from 1.0 m
+
